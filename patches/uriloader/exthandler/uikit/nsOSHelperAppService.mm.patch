+#import <MobileCoreServices/MobileCoreServices.h>
+
+#include "CFTypeRefPtr.h"
+#include "nsMIMEInfoUIKit.h"
 #include "nsOSHelperAppService.h"
+#include "nsReadableUtils.h"
+#include "nsString.h"
+
+static CFTypeRefPtr<CFStringRef> CreateUTIForTag(CFStringRef aTagClass,
+                                                 const nsACString& aTag) {
+  if (aTag.IsEmpty()) {
+    return nullptr;
+  }
+
+  const nsCString& flatTag = PromiseFlatCString(aTag);
+  auto tag =
+      CFTypeRefPtr<CFStringRef>::WrapUnderCreateRule(CFStringCreateWithBytes(
+          kCFAllocatorDefault, reinterpret_cast<const UInt8*>(flatTag.get()),
+          flatTag.Length(), kCFStringEncodingUTF8, false));
+  if (!tag) {
+    return nullptr;
+  }
+
+  return CFTypeRefPtr<CFStringRef>::WrapUnderCreateRule(
+      UTTypeCreatePreferredIdentifierForTag(aTagClass, tag.get(), kUTTypeData));
+}
+
+static bool IsUsableUTI(CFStringRef aUTI) {
+  return aUTI && UTTypeIsDeclared(aUTI) && !UTTypeIsDynamic(aUTI);
+}
+
+static bool CopyUTITag(CFStringRef aUTI, CFStringRef aTagClass,
+                       nsACString& aTag) {
+  aTag.Truncate();
+  auto tag = CFTypeRefPtr<CFStringRef>::WrapUnderCreateRule(
+      UTTypeCopyPreferredTagWithClass(aUTI, aTagClass));
+  if (!tag) {
+    return false;
+  }
+
+  CFIndex bufferLength =
+      CFStringGetMaximumSizeForEncoding(CFStringGetLength(tag.get()),
+                                        kCFStringEncodingUTF8) +
+      1;
+  nsAutoCString buffer;
+  buffer.SetLength(bufferLength);
+  bool copied = CFStringGetCString(tag.get(), buffer.BeginWriting(),
+                                   bufferLength, kCFStringEncodingUTF8);
+  if (copied) {
+    aTag.Assign(buffer.get());
+  }
+  return copied;
+}
 
 nsOSHelperAppService::nsOSHelperAppService() : nsExternalHelperAppService() {}
 
