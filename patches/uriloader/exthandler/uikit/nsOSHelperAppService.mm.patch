 NS_IMETHODIMP nsOSHelperAppService::GetMIMEInfoFromOS(
     const nsACString& aMIMEType, const nsACString& aFileExt, bool* aFound,
     nsIMIMEInfo** aMIMEInfo) {
+  nsCString fileExt(aFileExt);
+  if (!fileExt.IsEmpty() && fileExt.CharAt(0) == '.') {
+    fileExt.Cut(0, 1);
+  }
+  ToLowerCase(fileExt);
+
   *aMIMEInfo = nullptr;
   *aFound = false;
-  return NS_ERROR_NOT_IMPLEMENTED;
+
+  RefPtr<nsMIMEInfoUIKit> mimeInfo;
+
+  if (!aMIMEType.IsEmpty()) {
+    auto typeUTI = CreateUTIForTag(kUTTagClassMIMEType, aMIMEType);
+    if (IsUsableUTI(typeUTI.get()) &&
+        !UTTypeEqual(typeUTI.get(), kUTTypeData)) {
+      nsAutoCString preferredExtension;
+      if (CopyUTITag(typeUTI.get(), kUTTagClassFilenameExtension,
+                     preferredExtension) &&
+          !preferredExtension.IsEmpty()) {
+        mimeInfo = new nsMIMEInfoUIKit(aMIMEType);
+        ToLowerCase(preferredExtension);
+        mimeInfo->SetPrimaryExtension(preferredExtension);
+        *aFound = true;
+      }
+    }
+  }
+
+  if (!*aFound && !fileExt.IsEmpty()) {
+    auto extensionUTI = CreateUTIForTag(kUTTagClassFilenameExtension, fileExt);
+    if (IsUsableUTI(extensionUTI.get())) {
+      nsAutoCString mimeType;
+      if (CopyUTITag(extensionUTI.get(), kUTTagClassMIMEType, mimeType) &&
+          !mimeType.IsEmpty()) {
+        mimeInfo = new nsMIMEInfoUIKit(mimeType);
+        mimeInfo->SetPrimaryExtension(fileExt);
+        *aFound = true;
+      }
+    }
+  }
+
+  if (!*aFound) {
+    mimeInfo = new nsMIMEInfoUIKit(aMIMEType);
+  }
+
+  mimeInfo.forget(aMIMEInfo);
+  return NS_OK;
 }
 
