+  getFocusedInputBounds(focusedElement, viewportHeight) {
+    let bounds = focusedElement.getBoundingClientRect();
+    let ancestor = focusedElement.parentElement;
+
+    while (ancestor) {
+      const ancestorBounds = ancestor.getBoundingClientRect();
+      if (
+        ancestorBounds.top <= bounds.top &&
+        ancestorBounds.bottom >= bounds.bottom &&
+        ancestorBounds.height > bounds.height + 8 &&
+        ancestorBounds.height <= viewportHeight * 0.4
+      ) {
+        bounds = ancestorBounds;
+      }
+      ancestor = ancestor.parentElement;
+    }
+
+    return bounds;
+  }
+
+  async getFocusedInputMetrics() {
+    const { contentWindow } = this;
+    if (contentWindow) {
+      await new contentWindow.Promise(resolve => {
+        contentWindow.requestAnimationFrame(() => {
+          contentWindow.requestAnimationFrame(resolve);
+        });
+      });
+    }
+
+    const focusedElement = Services.focus.focusedElement || contentWindow?.document?.activeElement;
+    const win = focusedElement?.ownerGlobal || focusedElement?.documentGlobal;
+    if (
+      !win ||
+      !(
+        (win.HTMLInputElement?.isInstance(focusedElement) &&
+          focusedElement.mozIsTextField(false)) ||
+        win.HTMLTextAreaElement?.isInstance(focusedElement) ||
+        focusedElement.isContentEditable
+      )
+    ) {
+      return null;
+    }
+
+    const viewportHeight = win.visualViewport?.height || win.innerHeight;
+    if (!viewportHeight || viewportHeight <= 0) {
+      return null;
+    }
+
+    const bounds = this.getFocusedInputBounds(focusedElement, viewportHeight);
+    const { windowUtils } = win;
+    const metrics = {
+      bottomRatio: Math.max(0, Math.min(2, bounds.bottom / viewportHeight)),
+      caretTop: null,
+    };
+    const selection = windowUtils.sendQueryContentEvent(
+      windowUtils.QUERY_SELECTED_TEXT, 0, 0, 0, 0
+    );
+
+    if (!selection.succeeded || selection.notFound) {
+      return metrics;
+    }
+
+    const caret = windowUtils.sendQueryContentEvent(
+      windowUtils.QUERY_CARET_RECT,
+      selection.offset + selection.text.length,
+      0, 0, 0
+    );
+
+    if (caret.succeeded) {
+      metrics.caretTop = caret.top;
+    }
+
+    return metrics;
+  }
+
+  collectSessionState() {
+    const { docShell, contentWindow } = this;
+    const history = lazy.SessionHistory.collect(docShell);
+    let formdata = SessionStoreUtils.collectFormData(contentWindow);
+    let scrolldata = SessionStoreUtils.collectScrollPosition(contentWindow);
+
+    // Save the current document resolution.
+    let zoom = 1;
+    const domWindowUtils = contentWindow.windowUtils;
+    zoom = domWindowUtils.getResolution();
+    scrolldata = scrolldata || {};
+    scrolldata.zoom = {};
+    scrolldata.zoom.resolution = zoom;
+
+    // Save some data that'll help in adjusting the zoom level
+    // when restoring in a different screen orientation.
+    const displaySize = {};
+    const width = {},
+      height = {};
+    domWindowUtils.getDocumentViewerSize(width, height);
+
+    displaySize.width = width.value;
+    displaySize.height = height.value;
+
+    scrolldata.zoom.displaySize = displaySize;
+
+    formdata = lazy.PrivacyFilter.filterFormData(formdata || {});
+
+    return { history, formdata, scrolldata };
+  }
+
