+  // REYNARD: iOS has no out-of-process content: never attempt remoteness
+  // changes (ContextCanProcessSwitch aborts the switch when this is absent),
+  // and keep the browser in-process.
+  // NB: remoteness keys off presence of the attribute, not its value.
+  if (AppConstants.platform != "ios") {
+    browser.setAttribute("maychangeremoteness", "true");
+    browser.setAttribute(
+      "remoteType",
+      ChromeUtils.predictRemoteTypeForURI(null, {
+        window,
+        geckoViewSessionContextId: settings.sessionContextId ?? undefined,
+      })
+    );
+  }
+  if (AppConstants.platform == "ios") {
+    browser.removeAttribute("remote");
+  } else {
+    browser.setAttribute("remote", "true");
+  }
