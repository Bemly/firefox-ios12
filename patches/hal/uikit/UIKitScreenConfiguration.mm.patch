+#include "HalImpl.h"
+
+#include "mozilla/widget/GeckoViewSupport.h"
+#include "mozilla/widget/Screen.h"
+#include "mozilla/widget/ScreenManager.h"
+
+namespace mozilla::hal_impl {
+
+static bool IsSupportedScreenOrientation(
+    const hal::ScreenOrientation& aOrientation) {
+  static constexpr hal::ScreenOrientation kSupportedOrientations[] = {
+      hal::ScreenOrientation::PortraitPrimary,
+      hal::ScreenOrientation::PortraitSecondary,
+      hal::ScreenOrientation::PortraitPrimary |
+          hal::ScreenOrientation::PortraitSecondary,
+      hal::ScreenOrientation::LandscapePrimary,
+      hal::ScreenOrientation::LandscapeSecondary,
+      hal::ScreenOrientation::LandscapePrimary |
+          hal::ScreenOrientation::LandscapeSecondary,
+      hal::ScreenOrientation::PortraitPrimary |
+          hal::ScreenOrientation::PortraitSecondary |
+          hal::ScreenOrientation::LandscapePrimary |
+          hal::ScreenOrientation::LandscapeSecondary,
+      hal::ScreenOrientation::Default,
+  };
+
+  for (const auto supportedOrientation : kSupportedOrientations) {
+    if (aOrientation == supportedOrientation) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static UIInterfaceOrientationMask ToInterfaceOrientationMask(
+    const hal::ScreenOrientation& aOrientation) {
+  UIInterfaceOrientationMask orientationMask = 0;
+
+  if (aOrientation & hal::ScreenOrientation::PortraitPrimary) {
+    orientationMask |= UIInterfaceOrientationMaskPortrait;
+  }
+  if (aOrientation & hal::ScreenOrientation::PortraitSecondary) {
+    orientationMask |= UIInterfaceOrientationMaskPortraitUpsideDown;
+  }
+  if (aOrientation & hal::ScreenOrientation::LandscapePrimary) {
+    orientationMask |= UIInterfaceOrientationMaskLandscapeRight;
+  }
+  if (aOrientation & hal::ScreenOrientation::LandscapeSecondary) {
+    orientationMask |= UIInterfaceOrientationMaskLandscapeLeft;
+  }
+
+  return orientationMask;
+}
+
+RefPtr<GenericNonExclusivePromise> LockScreenOrientation(
+    const hal::ScreenOrientation& aOrientation) {
+  if (!IsSupportedScreenOrientation(aOrientation)) {
+    NS_WARNING("Unsupported screen orientation type");
+    return GenericNonExclusivePromise::CreateAndReject(
+        NS_ERROR_DOM_NOT_SUPPORTED_ERR, __func__);
+  }
+
+  id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime();
+  if (!runtime) {
+    return GenericNonExclusivePromise::CreateAndReject(NS_ERROR_DOM_ABORT_ERR,
+                                                       __func__);
+  }
+
+  hal::ScreenOrientation orientation = aOrientation;
+  if (orientation == hal::ScreenOrientation::Default) {
+    RefPtr<widget::Screen> screen =
+        widget::ScreenManager::GetSingleton().GetPrimaryScreen();
+    orientation = screen->GetDefaultOrientationType();
+  }
+
+  UIInterfaceOrientationMask orientationMask =
+      ToInterfaceOrientationMask(orientation);
+  RefPtr<GenericNonExclusivePromise::Private> promise =
+      new GenericNonExclusivePromise::Private(__func__);
+  [runtime lockScreenOrientation:orientationMask
+                      completion:^(GeckoOrientationLockResult result) {
+                        switch (result) {
+                          case GeckoOrientationLockResultSuccess:
+                            promise->Resolve(true, __func__);
+                            break;
+                          case GeckoOrientationLockResultRejected:
+                            promise->Reject(NS_ERROR_DOM_ABORT_ERR, __func__);
+                            break;
+                          case GeckoOrientationLockResultNotSupported:
+                            promise->Reject(NS_ERROR_DOM_NOT_SUPPORTED_ERR,
+                                            __func__);
+                            break;
+                        }
+                      }];
+  return promise;
+}
+
+void UnlockScreenOrientation() {
+  if (id<SwiftGeckoViewRuntime> runtime = widget::GetSwiftRuntime()) {
+    [runtime unlockScreenOrientation];
+  }
+}
+
+}  // namespace mozilla::hal_impl
