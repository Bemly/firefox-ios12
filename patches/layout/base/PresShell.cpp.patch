 void PresShell::UpdateCanvasBackground() {
-  mCanvasBackground = ComputeCanvasBackground();
+  CanvasBackground canvasBackground = ComputeCanvasBackground();
+
+#ifdef XP_IOS
+  const auto& oldViewportBackground = mCanvasBackground.mViewport;
+  const auto& newViewportBackground = canvasBackground.mViewport;
+  const bool backgroundChanged =
+      oldViewportBackground.mColor != newViewportBackground.mColor ||
+      oldViewportBackground.mCSSSpecified !=
+          newViewportBackground.mCSSSpecified;
+  if (backgroundChanged && this == GetRootPresShell() &&
+      mDocument->GetBrowsingContext() &&
+      mDocument->GetBrowsingContext()->IsTopContent()) {
+    nscolor backgroundColor = newViewportBackground.mColor;
+    if (!newViewportBackground.mCSSSpecified) {
