+          LookAndFeel::ColorID::Window, LookAndFeel::SystemColorScheme(),
+          LookAndFeel::UseStandins::No, NS_RGB(255, 255, 255));
+    }
+    if (BrowserChild* browserChild =
+            BrowserChild::GetFrom(mDocument->GetDocShell())) {
+      browserChild->UpdateBackgroundColor(backgroundColor);
+    }
+  }
+#endif
+
+  mCanvasBackground = canvasBackground;
 }
 
