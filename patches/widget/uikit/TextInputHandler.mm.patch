+void TextInputHandler::PostHandleKeyEvent(WidgetKeyboardEvent* aEvent) {
+  KeyEventState* currentKeyEvent = CurrentKeyEvent();
+  if (currentKeyEvent && aEvent && aEvent->mMessage == eKeyPress &&
