+static nscolor GetResolvedColor(UIColor* aColor, ColorScheme aColorScheme) {
+  if (@available(iOS 13.0, *)) {
+    return GetColorFromUIColor([aColor
+        resolvedColorWithTraitCollection:TraitCollectionForScheme(aColorScheme)]);
+  }
+  return GetColorFromUIColor(aColor);
+}
