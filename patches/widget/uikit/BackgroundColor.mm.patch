+#include "BackgroundColor.h"
+
+#include "js/Object.h"
+#include "js/PropertyAndElement.h"
+#include "js/RootingAPI.h"
+#include "js/Value.h"
+#include "mozilla/MacStringHelpers.h"
+#include "mozilla/dom/ScriptSettings.h"
+#include "mozilla/widget/EventDispatcher.h"
+#include "nsWindow.h"
+#include "xpcpublic.h"
+
+namespace mozilla::widget {
+
+void DispatchBackgroundColor(nsIWidget* aWidget, nscolor aColor) {
+  AssertIsOnMainThread();
+
+  RefPtr<nsWindow> window = nsWindow::From(aWidget);
+  if (!window) {
+    return;
+  }
+
+  EventDispatcher* dispatcher = window->GetEventDispatcher();
+  static constexpr auto kBackgroundColorEvent = u"GeckoView:BackgroundColor"_ns;
+  if (!dispatcher || !dispatcher->HasEmbedderListener(kBackgroundColorEvent)) {
+    return;
+  }
+
+  dom::AutoJSAPI jsapi;
+  if (!jsapi.Init(xpc::PrivilegedJunkScope())) {
+    return;
+  }
+
+  JSContext* cx = jsapi.cx();
+  JS::RootedObject payload(cx, JS_NewPlainObject(cx));
+  if (!payload) {
+    return;
+  }
+
+  auto defineComponent = [&](const char* aName, uint8_t aValue) {
+    JS::RootedValue jsValue(cx, JS::Int32Value(aValue));
+    return JS_DefineProperty(cx, payload, aName, jsValue, JSPROP_ENUMERATE);
+  };
+  if (!defineComponent("red", NS_GET_R(aColor)) ||
+      !defineComponent("green", NS_GET_G(aColor)) ||
+      !defineComponent("blue", NS_GET_B(aColor)) ||
+      !defineComponent("alpha", NS_GET_A(aColor))) {
+    return;
+  }
+
+  JS::RootedValue payloadValue(cx, JS::ObjectValue(*payload));
+  dispatcher->DispatchToEmbedder(cx, kBackgroundColorEvent, payloadValue,
+                                 nullptr);
+}
+
+}  // namespace mozilla::widget
