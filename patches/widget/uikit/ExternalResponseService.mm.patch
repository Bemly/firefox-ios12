+class ResponseHeaderCollector final : public nsIHttpHeaderVisitor {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+
+  ResponseHeaderCollector(JSContext* aCx, JS::HandleObject aHeaders)
+      : mCx(aCx), mHeaders(aCx, aHeaders) {}
+
+  nsresult AppendHeader(const nsACString& aName, const nsACString& aValue) {
+    JS::RootedObject header(mCx, JS_NewPlainObject(mCx));
+    if (!header) {
+      return NS_ERROR_OUT_OF_MEMORY;
+    }
+
+    if (!DefineUTF8StringProperty(mCx, header, "name", aName) ||
+        !DefineUTF8StringProperty(mCx, header, "value", aValue)) {
+      return NS_ERROR_FAILURE;
+    }
+
+    JS::RootedValue headerValue(mCx, JS::ObjectValue(*header));
+    JS::RootedObject headers(mCx, mHeaders);
+    if (!JS_SetElement(mCx, headers, mHeaderCount, headerValue)) {
+      return NS_ERROR_FAILURE;
+    }
+
+    ++mHeaderCount;
+    if (aName.Equals("content-disposition"_ns,
+                     nsCaseInsensitiveCStringComparator)) {
+      mHasContentDisposition = true;
+    }
+    return NS_OK;
+  }
+
+  NS_IMETHOD VisitHeader(const nsACString& aHeader,
+                         const nsACString& aValue) override {
+    return AppendHeader(aHeader, aValue);
+  }
+
+  bool HasContentDisposition() const { return mHasContentDisposition; }
+
+ private:
+  ~ResponseHeaderCollector() = default;
+
+  JSContext* mCx;
+  JS::PersistentRootedObject mHeaders;
+  uint32_t mHeaderCount = 0;
+  bool mHasContentDisposition = false;
+};
+
+NS_IMPL_ISUPPORTS(ResponseHeaderCollector, nsIHttpHeaderVisitor)
