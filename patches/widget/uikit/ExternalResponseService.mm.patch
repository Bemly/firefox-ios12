+NS_IMETHODIMP ExternalResponseListener::OnEvent(
+    const nsAString& aEvent, JS::Handle<JS::Value> aData,
+    nsIGeckoViewEventCallback* aCallback) {
+  bool isCancel = aEvent.EqualsLiteral(kExternalResponseCancelEvent);
+  bool isPause = aEvent.EqualsLiteral(kExternalResponsePauseEvent);
+  bool isResume = aEvent.EqualsLiteral(kExternalResponseResumeEvent);
+  if ((!isCancel && !isPause && !isResume) || !mRequest ||
+      !mCapturedResponseFile) {
+    return NS_OK;
+  }
+
+  if (isCancel) {
+    if (mTransferState != TransferState::AwaitingAcceptance &&
+        mTransferState != TransferState::Transferring &&
+        mTransferState != TransferState::Paused) {
+      return NS_OK;
+    }
+  } else if (isPause) {
+    if (mTransferState != TransferState::Transferring) {
+      return NS_OK;
+    }
+  } else if (mTransferState != TransferState::Paused) {
+    return NS_OK;
+  }
+
+  if (!aData.isObject()) {
+    return NS_OK;
+  }
+
+  dom::AutoJSAPI jsapi;
+  NS_ENSURE_TRUE(jsapi.Init(xpc::PrivilegedJunkScope()), NS_OK);
+
+  JSContext* cx = jsapi.cx();
+  JS::RootedObject data(cx, &aData.toObject());
+  JS::RootedValue pathValue(cx);
+  if (!JS_GetProperty(cx, data, "localFilePath", &pathValue)) {
+    JS_ClearPendingException(cx);
+    return NS_OK;
+  }
+  if (!pathValue.isString()) {
+    return NS_OK;
+  }
+
+  nsAutoJSString requestedPath;
+  if (!requestedPath.init(cx, pathValue.toString())) {
+    JS_ClearPendingException(cx);
+    return NS_OK;
+  }
+
+  nsAutoString capturedPath;
+  if (NS_FAILED(mCapturedResponseFile->GetPath(capturedPath)) ||
+      !requestedPath.Equals(capturedPath)) {
+    return NS_OK;
+  }
+
+  if (isCancel) {
+    mTransferState = TransferState::Finished;
+    UnregisterControlListeners();
+    CancelAndResumeRequest(mRequest, NS_BINDING_ABORTED);
+    mRequest = nullptr;
+    return NS_OK;
+  }
+
+  if (isPause) {
+    if (NS_SUCCEEDED(SuspendRequest(mRequest))) {
+      mTransferState = TransferState::Paused;
+    }
+    return NS_OK;
+  }
+
+  mTransferState = TransferState::Transferring;
+  nsresult rv = ResumeRequest(mRequest);
+  if (NS_FAILED(rv)) {
+    mTransferState = TransferState::Finished;
+    UnregisterControlListeners();
+    CancelAndResumeRequest(mRequest, rv);
+    mRequest = nullptr;
+    return NS_OK;
+  }
+
+  return NS_OK;
+}
+
+nsresult ExternalResponseListener::BeginCapturingResponseBody() {
+  nsresult rv = NS_GetSpecialDirectory(NS_OS_TEMP_DIR,
+                                       getter_AddRefs(mCapturedResponseFile));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  mCapturedResponseFile->AppendNative("reynard-download.tmp"_ns);
+  rv = mCapturedResponseFile->CreateUnique(nsIFile::NORMAL_FILE_TYPE, 0600);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = NS_NewLocalFileOutputStream(getter_AddRefs(mCapturedResponseStream),
+                                   mCapturedResponseFile);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  mCapturedBytes = 0;
+  mLastProgressReport = TimeStamp::Now();
+  return NS_OK;
+}
+
+void ExternalResponseListener::CloseCapturedResponseStream() {
+  if (!mCapturedResponseStream) {
+    return;
+  }
+
+  mCapturedResponseStream->Close();
+  mCapturedResponseStream = nullptr;
+}
+
+void ExternalResponseListener::CleanupCapturedResponseBody() {
+  CloseCapturedResponseStream();
+
+  if (mCapturedResponseFile) {
+    nsresult rv = mCapturedResponseFile->Remove(false);
+    if (NS_FAILED(rv)) {
+      NS_WARNING("Failed to remove captured external response file");
+    }
+    mCapturedResponseFile = nullptr;
+  }
+}
+
+void ExternalResponseListener::AbortStartup(nsIRequest* aRequest,
+                                            nsresult aStatus) {
+  mTransferState = TransferState::Finished;
+  UnregisterControlListeners();
+  CleanupCapturedResponseBody();
+  if (aRequest) {
+    CancelAndResumeRequest(aRequest, aStatus);
+  }
+  mRequest = nullptr;
+}
+
+nsresult ExternalResponseListener::RegisterControlListeners() {
+  if (mControlListenersRegistered) {
+    return NS_OK;
+  }
+
+  mozilla::widget::EventDispatcher* dispatcher = mWindow->GetEventDispatcher();
+  if (!dispatcher) {
+    return NS_ERROR_ABORT;
+  }
+
+  dom::AutoJSAPI jsapi;
+  NS_ENSURE_TRUE(jsapi.Init(xpc::PrivilegedJunkScope()), NS_ERROR_FAILURE);
+
+  JSContext* cx = jsapi.cx();
+  JS::RootedString cancelEvent(
+      cx, JS_NewStringCopyZ(cx, kExternalResponseCancelEvent));
+  JS::RootedString pauseEvent(
+      cx, JS_NewStringCopyZ(cx, kExternalResponsePauseEvent));
+  JS::RootedString resumeEvent(
+      cx, JS_NewStringCopyZ(cx, kExternalResponseResumeEvent));
+  NS_ENSURE_TRUE(cancelEvent && pauseEvent && resumeEvent,
+                 NS_ERROR_OUT_OF_MEMORY);
+
+  JS::RootedValue cancelValue(cx, JS::StringValue(cancelEvent));
+  JS::RootedValue pauseValue(cx, JS::StringValue(pauseEvent));
+  JS::RootedValue resumeValue(cx, JS::StringValue(resumeEvent));
+  nsresult rv = dispatcher->RegisterListener(this, cancelValue, cx);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  rv = dispatcher->RegisterListener(this, pauseValue, cx);
+  if (NS_FAILED(rv)) {
+    dispatcher->UnregisterListener(this, cancelValue, cx);
+    return rv;
+  }
+
+  rv = dispatcher->RegisterListener(this, resumeValue, cx);
+  if (NS_FAILED(rv)) {
+    dispatcher->UnregisterListener(this, pauseValue, cx);
+    dispatcher->UnregisterListener(this, cancelValue, cx);
+    return rv;
+  }
+
+  mControlListenersRegistered = true;
+  return rv;
+}
+
+void ExternalResponseListener::UnregisterControlListeners() {
+  if (!mControlListenersRegistered) {
+    return;
+  }
+
+  mozilla::widget::EventDispatcher* dispatcher = mWindow->GetEventDispatcher();
+  if (dispatcher) {
+    dom::AutoJSAPI jsapi;
+    if (jsapi.Init(xpc::PrivilegedJunkScope())) {
+      JSContext* cx = jsapi.cx();
+      JS::RootedString cancelEvent(
+          cx, JS_NewStringCopyZ(cx, kExternalResponseCancelEvent));
+      JS::RootedString pauseEvent(
+          cx, JS_NewStringCopyZ(cx, kExternalResponsePauseEvent));
+      JS::RootedString resumeEvent(
+          cx, JS_NewStringCopyZ(cx, kExternalResponseResumeEvent));
+      if (cancelEvent && pauseEvent && resumeEvent) {
+        JS::RootedValue cancelValue(cx, JS::StringValue(cancelEvent));
+        JS::RootedValue pauseValue(cx, JS::StringValue(pauseEvent));
+        JS::RootedValue resumeValue(cx, JS::StringValue(resumeEvent));
+        dispatcher->UnregisterListener(this, cancelValue, cx);
+        dispatcher->UnregisterListener(this, pauseValue, cx);
+        dispatcher->UnregisterListener(this, resumeValue, cx);
+      }
+    }
+  }
+  mControlListenersRegistered = false;
+}
+
+nsresult ExternalResponseListener::SuspendRequest(nsIRequest* aRequest) {
+  if (mRequestSuspended) {
+    return NS_OK;
+  }
+
+  nsresult rv = aRequest->Suspend();
+  if (NS_SUCCEEDED(rv)) {
+    mRequestSuspended = true;
+  }
+  return rv;
+}
+
+nsresult ExternalResponseListener::ResumeRequest(nsIRequest* aRequest) {
+  if (!mRequestSuspended) {
+    return NS_OK;
+  }
+
+  nsresult rv = aRequest->Resume();
+  if (NS_SUCCEEDED(rv)) {
+    mRequestSuspended = false;
+  } else {
+    NS_WARNING("Failed to resume external response request");
+  }
+  return rv;
+}
+
+void ExternalResponseListener::CancelAndResumeRequest(nsIRequest* aRequest,
+                                                      nsresult aStatus) {
+  aRequest->Cancel(aStatus);
+  ResumeRequest(aRequest);
+}
+
+void ExternalResponseListener::HandleDecision(nsIRequest* aRequest,
+                                              DecisionType aType,
+                                              bool aShouldContinue) {
+  AssertIsOnMainThread();
+
+  if (aType == DecisionType::Acceptance) {
+    if (mTransferState != TransferState::AwaitingAcceptance) {
+      return;
+    }
+
+    if (!aShouldContinue) {
+      mTransferState = TransferState::Finished;
+      UnregisterControlListeners();
+      CleanupCapturedResponseBody();
+      CancelAndResumeRequest(aRequest, NS_BINDING_ABORTED);
+      mRequest = nullptr;
+      return;
+    }
+
+    mTransferState = TransferState::Transferring;
+    nsresult rv = ResumeRequest(aRequest);
+    if (NS_FAILED(rv)) {
+      mTransferState = TransferState::Finished;
+      CancelAndResumeRequest(aRequest, rv);
+    }
+    return;
+  }
+
+  if (mTransferState != TransferState::Transferring) {
+    return;
+  }
+
+  if (!aShouldContinue) {
+    mTransferState = TransferState::Finished;
+    UnregisterControlListeners();
+    CancelAndResumeRequest(aRequest, NS_BINDING_ABORTED);
+    mRequest = nullptr;
+    return;
+  }
+
+  nsresult rv = ResumeRequest(aRequest);
+  if (NS_FAILED(rv)) {
+    mTransferState = TransferState::Finished;
+    CancelAndResumeRequest(aRequest, rv);
+  }
+}
+
+nsresult ExternalResponseListener::DispatchProgress(nsIRequest* aRequest) {
+  AssertIsOnMainThread();
+
+  if (mWindow->Destroyed() || !mCapturedResponseFile) {
+    return NS_ERROR_ABORT;
+  }
+
+  mozilla::widget::EventDispatcher* dispatcher = mWindow->GetEventDispatcher();
+  if (!dispatcher ||
+      !dispatcher->HasEmbedderListener(kExternalResponseProgressEvent)) {
+    return NS_ERROR_ABORT;
+  }
+
+  dom::AutoJSAPI jsapi;
+  NS_ENSURE_TRUE(jsapi.Init(xpc::PrivilegedJunkScope()), NS_ERROR_FAILURE);
+
+  JSContext* cx = jsapi.cx();
+  JS::RootedObject payload(cx, JS_NewPlainObject(cx));
+  NS_ENSURE_TRUE(payload, NS_ERROR_OUT_OF_MEMORY);
+
+  nsAutoString localFilePath;
+  nsresult rv = mCapturedResponseFile->GetPath(localFilePath);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(
+      DefineUTF16StringProperty(cx, payload, "localFilePath", localFilePath),
+      NS_ERROR_FAILURE);
+  NS_ENSURE_TRUE(DefineInt64Property(cx, payload, "bytesReceived",
+                                     static_cast<int64_t>(mCapturedBytes)),
+                 NS_ERROR_FAILURE);
+
+  mLastProgressReport = TimeStamp::Now();
+  RefPtr<ExternalResponseDecisionCallback> callback =
+      new ExternalResponseDecisionCallback(this, aRequest,
+                                           DecisionType::Progress);
+  rv = SuspendRequest(aRequest);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  JS::RootedValue payloadValue(cx, JS::ObjectValue(*payload));
+  return dispatcher->DispatchToEmbedder(cx, kExternalResponseProgressEvent,
+                                        payloadValue, callback);
+}
+
+nsresult ExternalResponseListener::DispatchCompletion(bool aSucceeded) {
+  AssertIsOnMainThread();
+
+  if (mWindow->Destroyed() || !mCapturedResponseFile) {
+    return NS_ERROR_ABORT;
+  }
+
+  mozilla::widget::EventDispatcher* dispatcher = mWindow->GetEventDispatcher();
+  if (!dispatcher ||
+      !dispatcher->HasEmbedderListener(kExternalResponseCompleteEvent)) {
+    return NS_ERROR_ABORT;
+  }
+
+  dom::AutoJSAPI jsapi;
+  NS_ENSURE_TRUE(jsapi.Init(xpc::PrivilegedJunkScope()), NS_ERROR_FAILURE);
+
+  JSContext* cx = jsapi.cx();
+  JS::RootedObject payload(cx, JS_NewPlainObject(cx));
+  NS_ENSURE_TRUE(payload, NS_ERROR_OUT_OF_MEMORY);
+
+  nsAutoString localFilePath;
+  nsresult rv = mCapturedResponseFile->GetPath(localFilePath);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(
+      DefineUTF16StringProperty(cx, payload, "localFilePath", localFilePath),
+      NS_ERROR_FAILURE);
+  NS_ENSURE_TRUE(
+      JS_DefineProperty(cx, payload, "succeeded", aSucceeded, JSPROP_ENUMERATE),
+      NS_ERROR_FAILURE);
+
+  JS::RootedValue payloadValue(cx, JS::ObjectValue(*payload));
+  return dispatcher->DispatchToEmbedder(cx, kExternalResponseCompleteEvent,
+                                        payloadValue, nullptr);
+}
+
+nsresult ExternalResponseListener::DispatchExternalResponse(
+    nsIChannel* aChannel, nsIGeckoViewEventCallback* aCallback) {
+  AssertIsOnMainThread();
+
+  if (mWindow->Destroyed()) {
+    return NS_ERROR_ABORT;
+  }
+
+  mozilla::widget::EventDispatcher* dispatcher = mWindow->GetEventDispatcher();
+  if (!dispatcher) {
+    return NS_ERROR_ABORT;
+  }
+
+  if (!dispatcher->HasEmbedderListener(kExternalResponseEvent)) {
+    return NS_ERROR_ABORT;
+  }
+
+  dom::AutoJSAPI jsapi;
+  NS_ENSURE_TRUE(jsapi.Init(xpc::PrivilegedJunkScope()), NS_ERROR_FAILURE);
+
+  JSContext* cx = jsapi.cx();
+  JS::RootedObject payload(cx, JS_NewPlainObject(cx));
+  NS_ENSURE_TRUE(payload, NS_ERROR_OUT_OF_MEMORY);
+
+  JS::RootedObject headers(cx, JS::NewArrayObject(cx, 0));
+  NS_ENSURE_TRUE(headers, NS_ERROR_OUT_OF_MEMORY);
+
+  nsCOMPtr<nsIURI> uri;
+  nsresult rv = aChannel->GetURI(getter_AddRefs(uri));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  nsAutoCString uriSpec;
+  rv = uri->GetSpec(uriSpec);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  NS_ENSURE_TRUE(DefineUTF8StringProperty(cx, payload, "url", uriSpec),
+                 NS_ERROR_FAILURE);
+
+  NS_ENSURE_TRUE(mCapturedResponseFile, NS_ERROR_FAILURE);
+  nsAutoString localFilePath;
+  rv = mCapturedResponseFile->GetPath(localFilePath);
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(
+      DefineUTF16StringProperty(cx, payload, "localFilePath", localFilePath),
+      NS_ERROR_FAILURE);
+
+  JS::RootedValue headersValue(cx, JS::ObjectValue(*headers));
+  NS_ENSURE_TRUE(
+      JS_DefineProperty(cx, payload, "headers", headersValue, JSPROP_ENUMERATE),
+      NS_ERROR_FAILURE);
+
+  nsCString mimeType;
+  aChannel->GetContentType(mimeType);
+  if (!mimeType.IsEmpty()) {
+    NS_ENSURE_TRUE(DefineUTF8StringProperty(cx, payload, "mimeType", mimeType),
+                   NS_ERROR_FAILURE);
+  }
+
+  uint32_t filenameFlags = nsIMIMEService::VALIDATE_DEFAULT;
+  if (mimeType.IsEmpty()) {
+    filenameFlags = nsIMIMEService::VALIDATE_SANITIZE_ONLY;
+  } else if (mimeType.Equals(APPLICATION_GUESS_FROM_EXT,
+                             nsCaseInsensitiveCStringComparator)) {
+    filenameFlags = nsIMIMEService::VALIDATE_GUESS_FROM_EXTENSION;
+  }
+
+  nsCOMPtr<nsIMIMEService> mimeService = do_GetService("@mozilla.org/mime;1");
+  NS_ENSURE_TRUE(mimeService, NS_ERROR_FAILURE);
+
+  nsString filename;
+  nsresult filenameRv = mimeService->GetValidFileName(
+      aChannel, mimeType, nullptr, filenameFlags, filename);
+  NS_ENSURE_SUCCESS(filenameRv, filenameRv);
+  if (!filename.IsEmpty()) {
+    NS_ENSURE_TRUE(DefineUTF16StringProperty(cx, payload, "filename", filename),
+                   NS_ERROR_FAILURE);
+  }
+
+  int64_t contentLength = 0;
+  bool hasContentLength =
+      NS_SUCCEEDED(aChannel->GetContentLength(&contentLength)) &&
+      contentLength >= 0;
+  if (hasContentLength) {
+    NS_ENSURE_TRUE(
+        DefineInt64Property(cx, payload, "contentLength", contentLength),
+        NS_ERROR_FAILURE);
+  }
+
+  uint32_t statusCode = 0;
+  nsCOMPtr<nsIHttpChannel> httpChannel = do_QueryInterface(aChannel);
+  RefPtr<ResponseHeaderCollector> headerCollector =
+      new ResponseHeaderCollector(cx, headers);
+  if (httpChannel) {
+    rv = httpChannel->GetResponseStatus(&statusCode);
+    NS_ENSURE_SUCCESS(rv, rv);
+
+    rv = httpChannel->VisitOriginalResponseHeaders(headerCollector);
+    NS_ENSURE_SUCCESS(rv, rv);
+  } else {
+    nsCString contentType;
+    if (NS_SUCCEEDED(aChannel->GetContentType(contentType))) {
+      rv = headerCollector->AppendHeader("content-type"_ns, contentType);
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+
+    int64_t nonHttpContentLength = 0;
+    if (NS_SUCCEEDED(aChannel->GetContentLength(&nonHttpContentLength))) {
+      nsAutoCString contentLengthString;
+      contentLengthString.AppendInt(nonHttpContentLength);
+      rv = headerCollector->AppendHeader("content-length"_ns,
+                                         contentLengthString);
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+  }
+
+  if (!headerCollector->HasContentDisposition()) {
+    nsString contentDispositionFilename;
+    if (NS_SUCCEEDED(aChannel->GetContentDispositionFilename(
+            contentDispositionFilename))) {
+      nsPrintfCString contentDisposition(
+          "attachment; filename=\"%s\"",
+          NS_ConvertUTF16toUTF8(contentDispositionFilename).get());
+      rv = headerCollector->AppendHeader("content-disposition"_ns,
+                                         contentDisposition);
+      NS_ENSURE_SUCCESS(rv, rv);
+    }
+  }
+
+  NS_ENSURE_TRUE(JS_DefineProperty(cx, payload, "statusCode", statusCode,
+                                   JSPROP_ENUMERATE),
+                 NS_ERROR_FAILURE);
+
+  JS::RootedValue payloadValue(cx, JS::ObjectValue(*payload));
+  return dispatcher->DispatchToEmbedder(cx, kExternalResponseEvent,
+                                        payloadValue, aCallback);
+}
+
+}  // namespace
+
+mozilla::StaticRefPtr<ExternalResponseService>
+    ExternalResponseService::sService;
+
+already_AddRefed<ExternalResponseService>
+ExternalResponseService::GetSingleton() {
+  if (!sService) {
+    sService = new ExternalResponseService();
+  }
+
+  RefPtr<ExternalResponseService> service = sService;
+  return service.forget();
+}
+
+ExternalResponseService::ExternalResponseService() = default;
+
+NS_IMPL_ISUPPORTS(ExternalResponseService, nsIExternalHelperAppService)
+
+NS_IMETHODIMP ExternalResponseService::DoContent(
+    const nsACString& aMimeContentType, nsIChannel* aChannel,
+    nsIInterfaceRequestor* aContentContext, bool aForceSave,
+    nsIInterfaceRequestor* aWindowContext,
+    nsIStreamListener** aStreamListener) {
+  return NS_ERROR_FAILURE;
+}
+
+NS_IMETHODIMP ExternalResponseService::CreateListener(
+    const nsACString& aMimeContentType, nsIChannel* aChannel,
+    mozilla::dom::BrowsingContext* aContentContext, bool aForceSave,
+    nsIInterfaceRequestor* aWindowContext,
+    nsIStreamListener** aStreamListener) {
+  MOZ_ASSERT(XRE_IsParentProcess());
+  NS_ENSURE_ARG_POINTER(aChannel);
+  NS_ENSURE_ARG_POINTER(aContentContext);
+  NS_ENSURE_ARG_POINTER(aStreamListener);
+
+  nsCOMPtr<nsIWidget> widget =
+      aContentContext->Canonical()->GetParentProcessWidgetContaining();
+  if (!widget) {
+    return NS_ERROR_ABORT;
+  }
+
+  RefPtr<nsWindow> window = nsWindow::From(widget);
+  if (NS_WARN_IF(!window) || NS_WARN_IF(window->Destroyed())) {
+    return NS_ERROR_ABORT;
+  }
+
+  RefPtr<ExternalResponseListener> listener =
+      new ExternalResponseListener(window);
+  nsresult rv = aChannel->SetNotificationCallbacks(listener);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  listener.forget(aStreamListener);
+  return NS_OK;
+}
+
+NS_IMETHODIMP ExternalResponseService::ApplyDecodingForExtension(
+    const nsACString& aExtension, const nsACString& aEncodingType,
+    bool* aApplyDecoding) {
+  *aApplyDecoding = true;
+  return NS_OK;
+}
+
+NS_IMETHODIMP ExternalResponseService::GetPreferredDownloadsDirectory(
+    nsIFile** aResult) {
+  NS_ENSURE_ARG_POINTER(aResult);
+  *aResult = nullptr;
+  return NS_ERROR_NOT_IMPLEMENTED;
+}
