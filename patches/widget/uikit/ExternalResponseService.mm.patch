+NS_IMETHODIMP ExternalResponseListener::OnStartRequest(nsIRequest* aRequest) {
+  MOZ_ASSERT(mTransferState == TransferState::PendingStart);
+
+  nsresult status = NS_OK;
+  aRequest->GetStatus(&status);
+  if (NS_FAILED(status)) {
+    AbortStartup(aRequest, status);
+    return NS_OK;
+  }
+
+  nsCOMPtr<nsIChannel> channel = do_QueryInterface(aRequest);
+  if (!channel) {
+    AbortStartup(aRequest, NS_ERROR_ABORT);
+    return NS_OK;
+  }
+
+  int32_t classification = nsContentSecurityUtils::ClassifyDownload(channel);
+  if (classification == nsITransfer::DOWNLOAD_FORBIDDEN) {
+    AbortStartup(aRequest, NS_ERROR_ABORT);
+    return NS_OK;
+  }
+
+  nsresult rv = BeginCapturingResponseBody();
+  if (NS_FAILED(rv)) {
+    AbortStartup(aRequest, rv);
+    return rv;
+  }
+
+  rv = SuspendRequest(aRequest);
+  if (NS_FAILED(rv)) {
+    AbortStartup(aRequest, rv);
+    return rv;
+  }
+  mTransferState = TransferState::AwaitingAcceptance;
+  mRequest = aRequest;
+
+  rv = RegisterControlListeners();
+  if (NS_FAILED(rv)) {
+    AbortStartup(aRequest, rv);
+    return rv;
+  }
+
+  RefPtr<ExternalResponseDecisionCallback> callback =
+      new ExternalResponseDecisionCallback(this, aRequest,
+                                           DecisionType::Acceptance);
+  rv = DispatchExternalResponse(channel, callback);
+  if (NS_FAILED(rv)) {
+    AbortStartup(aRequest, rv);
+  }
+  return rv;
+}
+
+NS_IMETHODIMP ExternalResponseListener::OnStopRequest(nsIRequest* aRequest,
+                                                      nsresult aStatusCode) {
+  bool succeeded = NS_SUCCEEDED(aStatusCode) &&
+                   mTransferState == TransferState::Transferring;
+  mTransferState = TransferState::Finished;
+
+  UnregisterControlListeners();
+  ResumeRequest(aRequest);
+  mRequest = nullptr;
+
+  if (!mCapturedResponseFile) {
+    return NS_OK;
+  }
+
+  CloseCapturedResponseStream();
+
+  nsresult rv = DispatchCompletion(succeeded);
+  if (succeeded && NS_SUCCEEDED(rv)) {
+    mCapturedResponseFile = nullptr;
+  } else {
+    CleanupCapturedResponseBody();
+  }
+
+  return succeeded ? rv : NS_OK;
+}
+
+NS_IMETHODIMP ExternalResponseListener::OnDataAvailable(
+    nsIRequest* aRequest, nsIInputStream* aInputStream, uint64_t aOffset,
+    uint32_t aCount) {
+  if (mTransferState != TransferState::Transferring ||
+      !mCapturedResponseStream) {
+    return NS_ERROR_ABORT;
+  }
+
+  uint32_t written = 0;
+  nsresult rv = aInputStream->ReadSegments(
+      NS_CopySegmentToStream, mCapturedResponseStream, aCount, &written);
+  if (NS_FAILED(rv)) {
+    mTransferState = TransferState::Finished;
+    CancelAndResumeRequest(aRequest, rv);
+    return rv;
+  }
+
+  mCapturedBytes += written;
+  static const TimeDuration kProgressInterval =
+      TimeDuration::FromMilliseconds(500);
+  if (TimeStamp::Now() - mLastProgressReport >= kProgressInterval) {
+    rv = DispatchProgress(aRequest);
+    if (NS_FAILED(rv)) {
+      mTransferState = TransferState::Finished;
+      CancelAndResumeRequest(aRequest, rv);
+      return rv;
+    }
+  }
+  return NS_OK;
+}
