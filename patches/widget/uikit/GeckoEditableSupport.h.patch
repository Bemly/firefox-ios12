+// MARK: - Credential Utilities
+
+inline NSInteger EffectiveOriginPort(NSURLComponents* aComponents) {
+  if (aComponents.port) {
+    return aComponents.port.integerValue;
+  }
+  NSString* scheme = aComponents.scheme.lowercaseString;
+  if ([scheme isEqualToString:@"http"]) {
+    return 80;
+  }
+  if ([scheme isEqualToString:@"https"]) {
+    return 443;
+  }
+  return NSNotFound;
+}
+
+inline BOOL CredentialOriginsMatch(NSURL* aDocumentURL,
+                                   NSString* aExpectedOrigin) {
+  NSURLComponents* documentOrigin =
+      [NSURLComponents componentsWithURL:aDocumentURL
+                 resolvingAgainstBaseURL:NO];
+  NSURLComponents* expectedOrigin =
+      [NSURLComponents componentsWithString:aExpectedOrigin];
+  NSString* documentScheme = documentOrigin.scheme.lowercaseString;
+  NSString* expectedScheme = expectedOrigin.scheme.lowercaseString;
+  NSString* documentHost = documentOrigin.host.lowercaseString;
+  NSString* expectedHost = expectedOrigin.host.lowercaseString;
+  if (!documentScheme || !expectedScheme || !documentHost || !expectedHost) {
+    return NO;
+  }
+  if (![documentScheme isEqualToString:expectedScheme] ||
+      ![documentHost isEqualToString:expectedHost]) {
+    return NO;
+  }
+  return EffectiveOriginPort(documentOrigin) ==
+         EffectiveOriginPort(expectedOrigin);
+}
