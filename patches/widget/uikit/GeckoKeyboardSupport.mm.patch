+static CodeNameIndex ComputeCodeNameIndex(uint16_t aKeyCode) {
+  if (aKeyCode >= kVK0 && aKeyCode <= kVK9) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_Digit0 +
+                                      (aKeyCode - kVK0));
+  }
+  if (aKeyCode >= kVKA && aKeyCode <= kVKZ) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_KeyA + (aKeyCode - kVKA));
+  }
+  if (aKeyCode >= kVKNumpad0 && aKeyCode <= kVKNumpad9) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_Numpad0 +
+                                      (aKeyCode - kVKNumpad0));
+  }
+  if (aKeyCode >= kVKF1 && aKeyCode <= kVKF20) {
+    return static_cast<CodeNameIndex>(CODE_NAME_INDEX_F1 + (aKeyCode - kVKF1));
+  }
+
+  switch (aKeyCode) {
+    case kVKOEM3:
+      return CODE_NAME_INDEX_Backquote;
+    case kVKOEM5:
+      return CODE_NAME_INDEX_Backslash;
+    case kVKBack:
+      return CODE_NAME_INDEX_Backspace;
+    case kVKOEM4:
+      return CODE_NAME_INDEX_BracketLeft;
+    case kVKOEM6:
+      return CODE_NAME_INDEX_BracketRight;
+    case kVKOEMComma:
+      return CODE_NAME_INDEX_Comma;
+    case kVKOEMPlus:
+      return CODE_NAME_INDEX_Equal;
+    case kVKOEM102:
+      return CODE_NAME_INDEX_IntlBackslash;
+    case kVKOEMMinus:
+      return CODE_NAME_INDEX_Minus;
+    case kVKOEMPeriod:
+      return CODE_NAME_INDEX_Period;
+    case kVKOEM7:
+      return CODE_NAME_INDEX_Quote;
+    case kVKOEM1:
+      return CODE_NAME_INDEX_Semicolon;
+    case kVKOEM2:
+      return CODE_NAME_INDEX_Slash;
+    case kVKLMenu:
+      return CODE_NAME_INDEX_AltLeft;
+    case kVKRMenu:
+      return CODE_NAME_INDEX_AltRight;
+    case kVKCapital:
+      return CODE_NAME_INDEX_CapsLock;
+    case kVKLControl:
+      return CODE_NAME_INDEX_ControlLeft;
+    case kVKRControl:
+      return CODE_NAME_INDEX_ControlRight;
+    case kVKReturn:
+      return CODE_NAME_INDEX_Enter;
+    case kVKLWin:
+      return CODE_NAME_INDEX_MetaLeft;
+    case kVKApps:
+    case kVKRWin:
+      return CODE_NAME_INDEX_MetaRight;
+    case kVKLShift:
+      return CODE_NAME_INDEX_ShiftLeft;
+    case kVKRShift:
+      return CODE_NAME_INDEX_ShiftRight;
+    case kVKSpace:
+      return CODE_NAME_INDEX_Space;
+    case kVKTab:
+      return CODE_NAME_INDEX_Tab;
+    case kVKKana:
+      return CODE_NAME_INDEX_KanaMode;
+    case kVKDelete:
+      return CODE_NAME_INDEX_Delete;
+    case kVKEnd:
+      return CODE_NAME_INDEX_End;
+    case kVKHelp:
+      return CODE_NAME_INDEX_Help;
+    case kVKHome:
+      return CODE_NAME_INDEX_Home;
+    case kVKInsert:
+      return CODE_NAME_INDEX_Insert;
+    case kVKNext:
+      return CODE_NAME_INDEX_PageDown;
+    case kVKPrior:
+      return CODE_NAME_INDEX_PageUp;
+    case kVKDown:
+      return CODE_NAME_INDEX_ArrowDown;
+    case kVKLeft:
+      return CODE_NAME_INDEX_ArrowLeft;
+    case kVKRight:
+      return CODE_NAME_INDEX_ArrowRight;
+    case kVKUp:
+      return CODE_NAME_INDEX_ArrowUp;
+    case kVKNumLock:
+      return CODE_NAME_INDEX_NumLock;
+    case kVKAdd:
+      return CODE_NAME_INDEX_NumpadAdd;
+    case kVKSeparator:
+      return CODE_NAME_INDEX_NumpadComma;
+    case kVKDecimal:
+      return CODE_NAME_INDEX_NumpadDecimal;
+    case kVKDivide:
+      return CODE_NAME_INDEX_NumpadDivide;
+    case kVKClear:
+      return CODE_NAME_INDEX_NumpadEqual;
+    case kVKMultiply:
+      return CODE_NAME_INDEX_NumpadMultiply;
+    case kVKSubtract:
+      return CODE_NAME_INDEX_NumpadSubtract;
+    case kVKEscape:
+      return CODE_NAME_INDEX_Escape;
+    case kVKVolumeDown:
+      return CODE_NAME_INDEX_VolumeDown;
+    case kVKVolumeMute:
+      return CODE_NAME_INDEX_VolumeMute;
+    case kVKVolumeUp:
+      return CODE_NAME_INDEX_VolumeUp;
+    default:
+      return CODE_NAME_INDEX_UNKNOWN;
+  }
+}
