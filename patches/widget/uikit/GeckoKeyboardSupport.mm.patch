+static KeyNameIndex ComputeSpecialKeyNameIndex(uint16_t aKeyCode) {
+  if (aKeyCode >= kVKF1 && aKeyCode <= kVKF20) {
+    return static_cast<KeyNameIndex>(KEY_NAME_INDEX_F1 + (aKeyCode - kVKF1));
+  }
+
+  switch (aKeyCode) {
+    case kVKBack:
+      return KEY_NAME_INDEX_Backspace;
+    case kVKTab:
+      return KEY_NAME_INDEX_Tab;
+    case kVKClear:
+      return KEY_NAME_INDEX_Clear;
+    case kVKReturn:
+      return KEY_NAME_INDEX_Enter;
+    case kVKShift:
+    case kVKLShift:
+    case kVKRShift:
+      return KEY_NAME_INDEX_Shift;
+    case kVKControl:
+    case kVKLControl:
+    case kVKRControl:
+      return KEY_NAME_INDEX_Control;
+    case kVKMenu:
+    case kVKLMenu:
+    case kVKRMenu:
+      return KEY_NAME_INDEX_Alt;
+    case kVKCapital:
+      return KEY_NAME_INDEX_CapsLock;
+    case kVKEscape:
+      return KEY_NAME_INDEX_Escape;
+    case kVKPrior:
+      return KEY_NAME_INDEX_PageUp;
+    case kVKNext:
+      return KEY_NAME_INDEX_PageDown;
+    case kVKEnd:
+      return KEY_NAME_INDEX_End;
+    case kVKHome:
+      return KEY_NAME_INDEX_Home;
+    case kVKLeft:
+      return KEY_NAME_INDEX_ArrowLeft;
+    case kVKUp:
+      return KEY_NAME_INDEX_ArrowUp;
+    case kVKRight:
+      return KEY_NAME_INDEX_ArrowRight;
+    case kVKDown:
+      return KEY_NAME_INDEX_ArrowDown;
+    case kVKInsert:
+      return KEY_NAME_INDEX_Insert;
+    case kVKDelete:
+      return KEY_NAME_INDEX_Delete;
+    case kVKLWin:
+    case kVKRWin:
+    case kVKApps:
+      return KEY_NAME_INDEX_Meta;
+    case kVKNumLock:
+      return KEY_NAME_INDEX_NumLock;
+    case kVKKana:
+      return KEY_NAME_INDEX_KanaMode;
+    case kVKHelp:
+      return KEY_NAME_INDEX_Help;
+    case kVKVolumeDown:
+      return KEY_NAME_INDEX_AudioVolumeDown;
+    case kVKVolumeMute:
+      return KEY_NAME_INDEX_AudioVolumeMute;
+    case kVKVolumeUp:
+      return KEY_NAME_INDEX_AudioVolumeUp;
+    default:
+      return KEY_NAME_INDEX_Unidentified;
+  }
+}
+
+static bool IsWritingSystemCode(CodeNameIndex aCodeNameIndex) {
+  return (aCodeNameIndex >= CODE_NAME_INDEX_Backquote &&
+          aCodeNameIndex <= CODE_NAME_INDEX_Slash) ||
+         (aCodeNameIndex >= CODE_NAME_INDEX_KeyA &&
+          aCodeNameIndex <= CODE_NAME_INDEX_KeyZ) ||
+         aCodeNameIndex == CODE_NAME_INDEX_Space;
+}
+
+static uint32_t ComputeLegacyKeyCode(KeyNameIndex aKeyNameIndex,
+                                     CodeNameIndex aCodeNameIndex,
+                                     const nsAString& aKeyValue,
+                                     uint16_t aNativeKeyCode) {
+  if (aKeyNameIndex != KEY_NAME_INDEX_USE_STRING) {
+    uint32_t keyCode =
+        WidgetKeyboardEvent::ComputeKeyCodeFromKeyNameIndex(aKeyNameIndex);
+    return keyCode ? keyCode : aNativeKeyCode;
+  }
+  if (!aKeyValue.IsEmpty()) {
+    uint32_t keyCode = WidgetUtils::ComputeKeyCodeFromChar(aKeyValue[0]);
+    if (keyCode) {
+      return keyCode;
+    }
+  }
+  uint32_t keyCode =
+      WidgetKeyboardEvent::GetFallbackKeyCodeOfPunctuationKey(aCodeNameIndex);
+  return keyCode ? keyCode : aNativeKeyCode;
+}
+
+static bool IsModifierKeyName(KeyNameIndex aKeyNameIndex) {
+  return aKeyNameIndex == KEY_NAME_INDEX_Alt ||
+         aKeyNameIndex == KEY_NAME_INDEX_CapsLock ||
+         aKeyNameIndex == KEY_NAME_INDEX_Control ||
+         aKeyNameIndex == KEY_NAME_INDEX_Meta ||
+         aKeyNameIndex == KEY_NAME_INDEX_Shift;
+}
+
+static bool IsRepeatableSpecialKey(WebEvent* aEvent) {
+  const KeyNameIndex keyName = ComputeSpecialKeyNameIndex(aEvent.keyCode);
+  return aEvent.keyCode == kVKSpace ||
+         (keyName != KEY_NAME_INDEX_Unidentified &&
+          !IsModifierKeyName(keyName));
+}
+
+static CFTimeInterval PhysicalKeyRepeatInterval() {
+  using KeyRepeatIntervalFunction = double (*)();
+  static KeyRepeatIntervalFunction keyRepeatInterval =
+      reinterpret_cast<KeyRepeatIntervalFunction>(
+          dlsym(RTLD_DEFAULT, "_AXSKeyRepeatInterval"));
+  MOZ_RELEASE_ASSERT(keyRepeatInterval);
+  return keyRepeatInterval();
+}
+
+static uint16_t NativeKeyCodeForHIDUsage(NSUInteger aUsage) {
+  enum : NSUInteger {
+    kHIDUsageRightArrow = 0x4F,
+    kHIDUsageLeftArrow = 0x50,
+    kHIDUsageDownArrow = 0x51,
+    kHIDUsageUpArrow = 0x52,
+  };
+  switch (aUsage) {
+    case kHIDUsageRightArrow:
+      return kVKRight;
+    case kHIDUsageLeftArrow:
+      return kVKLeft;
+    case kHIDUsageDownArrow:
+      return kVKDown;
+    case kHIDUsageUpArrow:
+      return kVKUp;
+    default:
+      return 0;
+  }
+}
