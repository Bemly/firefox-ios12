+struct GeckoKeyboardSupport::HeldKey {
+  uint16_t mNativeKeyCode = 0;
+  uint32_t mKeyCode = 0;
+  KeyNameIndex mKeyNameIndex = KEY_NAME_INDEX_Unidentified;
+  CodeNameIndex mCodeNameIndex = CODE_NAME_INDEX_UNKNOWN;
+  nsString mKeyValue;
+  uint32_t mLocation = eKeyLocationStandard;
+};
+
+GeckoKeyboardSupport::GeckoKeyboardSupport(TextInputHandler* aHandler)
+    : mHandler(aHandler) {}
+
+GeckoKeyboardSupport::~GeckoKeyboardSupport() { StopKeyRepeat(); }
+
+void GeckoKeyboardSupport::InitKeyEvent(WebEvent* aNativeEvent,
+                                        WidgetKeyboardEvent& aEvent,
+                                        uint32_t aUniqueId,
+                                        bool aProcessedByIME,
+                                        const nsAString* aInsertString,
+                                        bool aForceRepeat) const {
+  aEvent.mModifiers = mCurrentModifiers;
+  aEvent.mCodeNameIndex = ComputeCodeNameIndex(aNativeEvent.keyCode);
+  aEvent.mLocation =
+      WidgetKeyboardEvent::ComputeLocationFromCodeValue(aEvent.mCodeNameIndex);
+  aEvent.mIsRepeat = aEvent.mMessage != eKeyUp &&
+                     (aForceRepeat || aNativeEvent.isKeyRepeating);
+  aEvent.mTimeStamp = aForceRepeat
+                          ? TimeStamp::Now()
+                          : GeckoTimeStampForWebEvent(aNativeEvent.timestamp);
+  aEvent.mUniqueId = aUniqueId;
+
+  if (aProcessedByIME) {
+    aEvent.mKeyNameIndex = KEY_NAME_INDEX_Process;
+    aEvent.mKeyCode = NS_VK_PROCESSKEY;
+    return;
+  }
+
+  aEvent.mKeyNameIndex = ComputeSpecialKeyNameIndex(aNativeEvent.keyCode);
+  if (aEvent.mKeyNameIndex == KEY_NAME_INDEX_Unidentified) {
+    NSString* nativeCharacters = aEvent.IsControl()
+                                     ? aNativeEvent.charactersIgnoringModifiers
+                                     : aNativeEvent.characters;
+    nsString characters;
+    if (aInsertString) {
+      characters = *aInsertString;
+    } else {
+      CopyNSStringToXPCOMString(nativeCharacters ?: @"", characters);
+    }
+    if (!characters.IsEmpty()) {
+      aEvent.mKeyNameIndex = KEY_NAME_INDEX_USE_STRING;
+      aEvent.mKeyValue = characters;
+      if (aEvent.mKeyValue[0] < 0x20 || aEvent.mKeyValue[0] == 0x7F) {
+        CopyNSStringToXPCOMString(
+            aNativeEvent.charactersIgnoringModifiers ?: @"", aEvent.mKeyValue);
+      }
+    } else if (IsWritingSystemCode(aEvent.mCodeNameIndex)) {
+      aEvent.mKeyNameIndex = KEY_NAME_INDEX_Dead;
+    }
+  }
+  aEvent.mKeyCode =
+      ComputeLegacyKeyCode(aEvent.mKeyNameIndex, aEvent.mCodeNameIndex,
+                           aEvent.mKeyValue, aNativeEvent.keyCode);
+}
