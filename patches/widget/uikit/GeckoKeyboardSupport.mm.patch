+static Modifiers GeckoModifiersForWebEventFlags(WebEventFlags aFlags) {
+  Modifiers modifiers = MODIFIER_NONE;
+  if (aFlags & WebEventFlagMaskLeftCapsLockKey) {
+    modifiers |= MODIFIER_CAPSLOCK;
+  }
+  if (aFlags & WebEventFlagMaskShiftKey) {
+    modifiers |= MODIFIER_SHIFT;
+  }
+  if (aFlags & WebEventFlagMaskControlKey) {
+    modifiers |= MODIFIER_CONTROL;
+  }
+  if (aFlags & WebEventFlagMaskOptionKey) {
+    modifiers |= MODIFIER_ALT;
+  }
+  if (aFlags & WebEventFlagMaskCommandKey) {
+    modifiers |= MODIFIER_META;
+  }
+  return modifiers;
+}
+
+static WebEventFlags CurrentWebEventFlags(WebEvent* aEvent) {
+  WebEventFlags modifierFlags = aEvent.modifierFlags;
+  if (aEvent.type == WebEventKeyDown) {
+    using ModifierFlagsFunction = WebEventFlags (*)(id, SEL);
+    static ModifierFlagsFunction modifierFlagsFunction =
+        reinterpret_cast<ModifierFlagsFunction>(objc_msgSend);
+    Class webEventClass = objc_getClass("WebEvent");
+    MOZ_RELEASE_ASSERT(webEventClass);
+    modifierFlags |= modifierFlagsFunction(reinterpret_cast<id>(webEventClass),
+                                           sel_registerName("modifierFlags"));
+  }
+  return modifierFlags;
+}
