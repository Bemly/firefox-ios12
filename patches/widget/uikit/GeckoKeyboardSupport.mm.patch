+Modifiers GeckoModifiersForUIKitModifiers(UIKeyModifierFlags aModifiers) {
+  Modifiers modifiers = MODIFIER_NONE;
+  if (aModifiers & UIKeyModifierAlphaShift) {
+    modifiers |= MODIFIER_CAPSLOCK;
+  }
+  if (aModifiers & UIKeyModifierShift) {
+    modifiers |= MODIFIER_SHIFT;
+  }
+  if (aModifiers & UIKeyModifierControl) {
+    modifiers |= MODIFIER_CONTROL;
+  }
+  if (aModifiers & UIKeyModifierAlternate) {
+    modifiers |= MODIFIER_ALT;
+  }
+  if (aModifiers & UIKeyModifierCommand) {
+    modifiers |= MODIFIER_META;
+  }
+  if (aModifiers & UIKeyModifierNumericPad) {
+    modifiers |= MODIFIER_NUMLOCK;
+  }
+  return modifiers;
+}
