+uint32_t GeckoKeyboardSupport::NextUniqueId() { return ++mNextEventId; }
+
+bool GeckoKeyboardSupport::Destroyed() const { return mHandler->Destroyed(); }
+
+void GeckoKeyboardSupport::RememberKeyDown(WebEvent* aEvent) {
+  if (aEvent.isKeyRepeating) {
+    return;
+  }
+  for (const auto& heldKey : mHeldKeys) {
+    if (heldKey->mNativeKeyCode == aEvent.keyCode) {
+      return;
+    }
+  }
+
+  WidgetKeyboardEvent keydownEvent(true, eKeyDown, mHandler->mWidget);
+  InitKeyEvent(aEvent, keydownEvent, 0);
+  auto heldKey = MakeUnique<HeldKey>();
+  heldKey->mNativeKeyCode = aEvent.keyCode;
+  heldKey->mKeyCode = keydownEvent.mKeyCode;
+  heldKey->mKeyNameIndex = keydownEvent.mKeyNameIndex;
+  heldKey->mCodeNameIndex = keydownEvent.mCodeNameIndex;
+  heldKey->mKeyValue = keydownEvent.mKeyValue;
+  heldKey->mLocation = keydownEvent.mLocation;
+  mHeldKeys.AppendElement(std::move(heldKey));
+}
+
+void GeckoKeyboardSupport::ForgetKeyUp(WebEvent* aEvent) {
+  mHeldKeys.RemoveElementsBy([aEvent](const UniquePtr<HeldKey>& aHeldKey) {
+    return aHeldKey->mNativeKeyCode == aEvent.keyCode;
+  });
+}
+
+void GeckoKeyboardSupport::StartKeyRepeat(WebEvent* aEvent) {
+  if (mKeyRepeatTimer || !IsRepeatableSpecialKey(aEvent)) {
+    return;
+  }
+
+  const CFTimeInterval interval = PhysicalKeyRepeatInterval();
+  if (interval <= 0) {
+    return;
+  }
+
+  mRepeatingEvent = [aEvent retain];
+  CFRunLoopTimerContext context = {0, this, nullptr, nullptr, nullptr};
+  mKeyRepeatTimer = CFRunLoopTimerCreate(
+      kCFAllocatorDefault, CFAbsoluteTimeGetCurrent() + interval, interval, 0,
+      0, KeyRepeatTimerFired, &context);
+  CFRunLoopAddTimer(CFRunLoopGetMain(), mKeyRepeatTimer, kCFRunLoopCommonModes);
+}
+
+void GeckoKeyboardSupport::StopKeyRepeat() {
+  if (mKeyRepeatTimer) {
+    CFRunLoopTimerInvalidate(mKeyRepeatTimer);
+    CFRelease(mKeyRepeatTimer);
+    mKeyRepeatTimer = nullptr;
+  }
+  [mRepeatingEvent release];
+  mRepeatingEvent = nil;
+}
+
+void GeckoKeyboardSupport::KeyRepeatTimerFired(CFRunLoopTimerRef, void* aInfo) {
+  static_cast<GeckoKeyboardSupport*>(aInfo)->RepeatKey();
+}
+
+void GeckoKeyboardSupport::RepeatKey() {
+  if (Destroyed() || !mRepeatingEvent) {
+    StopKeyRepeat();
+    return;
+  }
+
+  bool isHeld = false;
+  for (const auto& heldKey : mHeldKeys) {
+    if (heldKey->mNativeKeyCode == mRepeatingEvent.keyCode) {
+      isHeld = true;
+      break;
+    }
+  }
+  if (!isHeld) {
+    StopKeyRepeat();
+    return;
+  }
+
+  RefPtr<TextInputHandler> kungFuDeathGrip(mHandler);
+  mHandler->DispatchPhysicalKeyDown(mRepeatingEvent, true, false);
+}
+
+bool GeckoKeyboardSupport::DispatchKeyUp(WebEvent* aEvent) {
+  if (Destroyed()) {
+    return false;
+  }
+  nsresult rv = mHandler->mDispatcher->BeginNativeInputTransaction();
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+
+  WidgetKeyboardEvent keyupEvent(true, eKeyUp, mHandler->mWidget);
+  InitKeyEvent(aEvent, keyupEvent, 0);
+  nsEventStatus status = nsEventStatus_eIgnore;
+  return mHandler->mDispatcher->DispatchKeyboardEvent(eKeyUp, keyupEvent,
+                                                      status);
+}
+
+bool GeckoKeyboardSupport::DispatchHeldKeyUp(const HeldKey& aHeldKey,
+                                             Modifiers aModifiers) {
+  if (Destroyed()) {
+    return false;
+  }
+  nsresult rv = mHandler->mDispatcher->BeginNativeInputTransaction();
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+
+  WidgetKeyboardEvent keyupEvent(true, eKeyUp, mHandler->mWidget);
+  keyupEvent.mKeyCode = aHeldKey.mKeyCode;
+  keyupEvent.mKeyNameIndex = aHeldKey.mKeyNameIndex;
+  keyupEvent.mCodeNameIndex = aHeldKey.mCodeNameIndex;
+  keyupEvent.mKeyValue = aHeldKey.mKeyValue;
+  keyupEvent.mModifiers = aModifiers;
+  keyupEvent.mLocation = aHeldKey.mLocation;
+  keyupEvent.mIsRepeat = false;
+  keyupEvent.mTimeStamp = TimeStamp::Now();
+  nsEventStatus status = nsEventStatus_eIgnore;
+  return mHandler->mDispatcher->DispatchKeyboardEvent(eKeyUp, keyupEvent,
+                                                      status);
+}
+
+void GeckoKeyboardSupport::ReleasePhysicalKey(uint16_t aNativeKeyCode) {
+  for (size_t index = 0; index < mHeldKeys.Length(); ++index) {
+    if (mHeldKeys[index]->mNativeKeyCode != aNativeKeyCode) {
+      continue;
+    }
+
+    if (mRepeatingEvent && mRepeatingEvent.keyCode == aNativeKeyCode) {
+      StopKeyRepeat();
+    }
+    UniquePtr<HeldKey> heldKey = std::move(mHeldKeys[index]);
+    mHeldKeys.RemoveElementAt(index);
+    DispatchHeldKeyUp(*heldKey, mCurrentModifiers);
+    return;
+  }
+}
+
+void GeckoKeyboardSupport::ReleasePhysicalKeys() {
+  StopKeyRepeat();
+  nsTArray<UniquePtr<HeldKey>> heldKeys;
+  heldKeys.SwapElements(mHeldKeys);
+  Modifiers modifiers = mCurrentModifiers;
+  mCurrentModifiers = MODIFIER_NONE;
+  if (heldKeys.IsEmpty() || Destroyed()) {
+    return;
+  }
+
+  for (const auto& heldKey : heldKeys) {
+    if (!IsModifierKeyName(heldKey->mKeyNameIndex)) {
+      DispatchHeldKeyUp(*heldKey, modifiers);
+    }
+  }
+  for (const auto& heldKey : heldKeys) {
+    switch (heldKey->mKeyNameIndex) {
+      case KEY_NAME_INDEX_Alt:
+        modifiers &= ~MODIFIER_ALT;
+        break;
+      case KEY_NAME_INDEX_CapsLock:
+        modifiers &= ~MODIFIER_CAPSLOCK;
+        break;
+      case KEY_NAME_INDEX_Control:
+        modifiers &= ~MODIFIER_CONTROL;
+        break;
+      case KEY_NAME_INDEX_Meta:
+        modifiers &= ~MODIFIER_META;
+        break;
+      case KEY_NAME_INDEX_Shift:
+        modifiers &= ~MODIFIER_SHIFT;
+        break;
+      default:
+        continue;
+    }
+    DispatchHeldKeyUp(*heldKey, modifiers);
+  }
+}
+
+bool GeckoKeyboardSupport::HandleKeyEvent(WebEvent* aEvent) {
+  if (Destroyed() || !aEvent ||
+      (aEvent.type != WebEventKeyDown && aEvent.type != WebEventKeyUp)) {
+    return false;
+  }
+
+  RefPtr<TextInputHandler> kungFuDeathGrip(mHandler);
+  const Modifiers eventModifiers =
+      GeckoModifiersForWebEventFlags(CurrentWebEventFlags(aEvent));
+  mCurrentModifiers = eventModifiers | (mCurrentModifiers &
+                                        (MODIFIER_SHIFT | MODIFIER_CAPSLOCK));
+  if (aEvent.type == WebEventKeyUp) {
+    if (ComputeSpecialKeyNameIndex(aEvent.keyCode) == KEY_NAME_INDEX_Shift) {
+      mCurrentModifiers &= ~MODIFIER_SHIFT;
+    }
+    if (mRepeatingEvent && mRepeatingEvent.keyCode == aEvent.keyCode) {
+      StopKeyRepeat();
+    }
+    bool dispatched = DispatchKeyUp(aEvent);
+    ForgetKeyUp(aEvent);
+    return dispatched;
+  }
+
+  const bool modifierFlagsChanged =
+      aEvent.keyboardFlags & WebEventKeyboardInputModifierFlagsChanged;
+  if (modifierFlagsChanged && !aEvent.isKeyRepeating) {
+    KeyNameIndex keyName = ComputeSpecialKeyNameIndex(aEvent.keyCode);
+    for (const auto& heldKey : mHeldKeys) {
+      if (heldKey->mNativeKeyCode == aEvent.keyCode &&
+          IsModifierKeyName(keyName)) {
+        return true;
+      }
+    }
+  }
+
+  if (!aEvent.isKeyRepeating &&
+      !IsModifierKeyName(ComputeSpecialKeyNameIndex(aEvent.keyCode))) {
+    StopKeyRepeat();
+  } else if (aEvent.isKeyRepeating && mRepeatingEvent &&
+             mRepeatingEvent.keyCode == aEvent.keyCode) {
+    return true;
+  }
+
+  RememberKeyDown(aEvent);
+  bool handled = mHandler->DispatchPhysicalKeyDown(aEvent, false, true);
+  if (aEvent.isKeyRepeating && handled && !Destroyed()) {
+    StartKeyRepeat(aEvent);
+  }
+  return handled;
+}
+
+void GeckoKeyboardSupport::HandleModifierFlagsChanged(
+    UIKeyModifierFlags aOldFlags, UIKeyModifierFlags aNewFlags) {
+  struct ModifierTransition {
+    UIKeyModifierFlags mFlag;
+    uint16_t mNativeKeyCode;
+    KeyNameIndex mKeyNameIndex;
+    CodeNameIndex mCodeNameIndex;
+  };
+  constexpr ModifierTransition transitions[] = {
+      {UIKeyModifierShift, kVKLShift, KEY_NAME_INDEX_Shift,
+       CODE_NAME_INDEX_ShiftLeft},
+      {UIKeyModifierAlphaShift, kVKCapital, KEY_NAME_INDEX_CapsLock,
+       CODE_NAME_INDEX_CapsLock},
+  };
+
+  mCurrentModifiers = GeckoModifiersForUIKitModifiers(aNewFlags);
+  for (const auto& transition : transitions) {
+    bool wasDown = aOldFlags & transition.mFlag;
+    bool isDown = aNewFlags & transition.mFlag;
+    if (wasDown == isDown || Destroyed()) {
+      continue;
+    }
+
+    if (isDown) {
+      bool alreadyHeld = false;
+      for (const auto& heldKey : mHeldKeys) {
+        alreadyHeld |= heldKey->mNativeKeyCode == transition.mNativeKeyCode;
+      }
+      if (alreadyHeld) {
+        continue;
+      }
+      auto heldKey = MakeUnique<HeldKey>();
+      heldKey->mNativeKeyCode = transition.mNativeKeyCode;
+      heldKey->mKeyCode = WidgetKeyboardEvent::ComputeKeyCodeFromKeyNameIndex(
+          transition.mKeyNameIndex);
+      heldKey->mKeyNameIndex = transition.mKeyNameIndex;
+      heldKey->mCodeNameIndex = transition.mCodeNameIndex;
+      heldKey->mLocation = WidgetKeyboardEvent::ComputeLocationFromCodeValue(
+          heldKey->mCodeNameIndex);
+
+      WidgetKeyboardEvent keydownEvent(true, eKeyDown, mHandler->mWidget);
+      keydownEvent.mKeyCode = heldKey->mKeyCode;
+      keydownEvent.mKeyNameIndex = heldKey->mKeyNameIndex;
+      keydownEvent.mCodeNameIndex = heldKey->mCodeNameIndex;
+      keydownEvent.mModifiers = mCurrentModifiers;
+      keydownEvent.mLocation = heldKey->mLocation;
+      keydownEvent.mTimeStamp = TimeStamp::Now();
+      keydownEvent.mUniqueId = NextUniqueId();
+      nsEventStatus status = nsEventStatus_eIgnore;
+      if (NS_SUCCEEDED(mHandler->mDispatcher->BeginNativeInputTransaction())) {
+        mHeldKeys.AppendElement(std::move(heldKey));
+        mHandler->mDispatcher->DispatchKeyboardEvent(eKeyDown, keydownEvent,
+                                                     status);
+      }
+      continue;
+    }
+
+    for (size_t index = 0; index < mHeldKeys.Length(); ++index) {
+      if (mHeldKeys[index]->mNativeKeyCode == transition.mNativeKeyCode) {
+        UniquePtr<HeldKey> heldKey = std::move(mHeldKeys[index]);
+        mHeldKeys.RemoveElementAt(index);
+        DispatchHeldKeyUp(*heldKey, mCurrentModifiers);
+        break;
+      }
+    }
+  }
+}
+
+}  // namespace mozilla::widget
+
+// MARK: - ChildView (Keyboard)
+
+@interface UIResponder (Private)
+- (void)_handleKeyUIEvent:(UIEvent*)event;
+@end
+
+@interface UIEvent (Private)
+- (void*)_hidEvent;
+@end
+
+@interface ChildView : UIView {
+ @public
+  nsWindow* mGeckoChild;
+  GeckoEditableState mEditable;
+}
+@end
+
+@interface ChildView (Keyboard)
+- (BOOL)_requiresKeyboardWhenFirstResponder;
+- (BOOL)_requiresKeyboardResetOnReload;
+- (void)_handleKeyUIEvent:(UIEvent*)event;
+- (BOOL)requiresKeyEvents;
+- (void)handleKeyWebEvent:(WebEvent*)event;
+- (void)handleKeyWebEvent:(WebEvent*)event
+    withCompletionHandler:
+        (void (^)(WebEvent* event, BOOL wasHandled))completionHandler;
+- (void)modifierFlagsDidChangeFrom:(UIKeyModifierFlags)oldFlags
+                                to:(UIKeyModifierFlags)newFlags;
+- (void)pressesEnded:(NSSet<UIPress*>*)presses withEvent:(UIPressesEvent*)event;
+- (void)pressesCancelled:(NSSet<UIPress*>*)presses
+               withEvent:(UIPressesEvent*)event;
+@end
+
+@implementation ChildView (Keyboard)
+
+- (BOOL)_requiresKeyboardWhenFirstResponder {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return NO;
+  }
+  return mGeckoChild->GetInputContext().mIMEState.mEnabled !=
+             mozilla::widget::IMEEnabled::Disabled ||
+         mEditable.mSeenHardwareKeyDownInNonEditableContent;
+}
+
+- (BOOL)_requiresKeyboardResetOnReload {
+  return YES;
+}
+
+- (void)_handleKeyUIEvent:(UIEvent*)event {
+  BOOL isHardwareKeyboardEvent = [event _hidEvent] != nullptr;
+  if ([self isFirstResponder] && isHardwareKeyboardEvent && mGeckoChild &&
+      !mGeckoChild->Destroyed() &&
+      mGeckoChild->GetInputContext().mIMEState.mEnabled ==
+          mozilla::widget::IMEEnabled::Disabled &&
+      !mEditable.mSeenHardwareKeyDownInNonEditableContent) {
+    mEditable.mSeenHardwareKeyDownInNonEditableContent = YES;
+    [self reloadInputViews];
+  }
+  [super _handleKeyUIEvent:event];
+}
+
+- (BOOL)requiresKeyEvents {
+  return mGeckoChild && !mGeckoChild->Destroyed();
+}
+
+- (void)handleKeyWebEvent:(WebEvent*)event {
+  BOOL handled = NO;
+  if (mGeckoChild && !mGeckoChild->Destroyed()) {
+    if (mozilla::widget::TextInputHandler* handler =
+            mGeckoChild->GetTextInputHandler()) {
+      handled = handler->HandleKeyEvent(event);
+    }
+  }
+  event.wasHandled = handled;
+}
+
+- (void)handleKeyWebEvent:(WebEvent*)event
+    withCompletionHandler:
+        (void (^)(WebEvent* event, BOOL wasHandled))completionHandler {
+  BOOL handled = NO;
+  if (mGeckoChild && !mGeckoChild->Destroyed()) {
+    if (mozilla::widget::TextInputHandler* handler =
+            mGeckoChild->GetTextInputHandler()) {
+      handled = handler->HandleKeyEvent(event);
+    }
+  }
+  completionHandler(event, handled);
+}
+
+- (void)modifierFlagsDidChangeFrom:(UIKeyModifierFlags)oldFlags
+                                to:(UIKeyModifierFlags)newFlags {
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return;
+  }
+  if (mozilla::widget::TextInputHandler* handler =
+          mGeckoChild->GetTextInputHandler()) {
+    handler->HandleModifierFlagsChanged(oldFlags, newFlags);
+  }
+}
+
+- (void)pressesEnded:(NSSet<UIPress*>*)presses
+           withEvent:(UIPressesEvent*)event {
+  [super pressesEnded:presses withEvent:event];
+
+  if (!mGeckoChild || mGeckoChild->Destroyed()) {
+    return;
+  }
+  mozilla::widget::TextInputHandler* handler =
+      mGeckoChild->GetTextInputHandler();
+  if (!handler) {
+    return;
+  }
+
+  SEL keySelector = sel_registerName("key");
+  SEL keyCodeSelector = sel_registerName("keyCode");
+  using KeyFunction = id (*)(id, SEL);
+  using KeyCodeFunction = NSUInteger (*)(id, SEL);
+  for (UIPress* press in presses) {
+    if (![press respondsToSelector:keySelector]) {
+      continue;
+    }
+    id key = reinterpret_cast<KeyFunction>(objc_msgSend)(press, keySelector);
+    if (![key respondsToSelector:keyCodeSelector]) {
+      continue;
+    }
+    NSUInteger usage =
+        reinterpret_cast<KeyCodeFunction>(objc_msgSend)(key, keyCodeSelector);
+    uint16_t nativeKeyCode = mozilla::widget::NativeKeyCodeForHIDUsage(usage);
+    if (nativeKeyCode) {
+      handler->ReleasePhysicalKey(nativeKeyCode);
+    }
+  }
+}
+
+- (void)pressesCancelled:(NSSet<UIPress*>*)presses
+               withEvent:(UIPressesEvent*)event {
+  if (mGeckoChild && !mGeckoChild->Destroyed()) {
+    if (mozilla::widget::TextInputHandler* handler =
+            mGeckoChild->GetTextInputHandler()) {
+      handler->ReleasePhysicalKeys();
+    }
+  }
+  [super pressesCancelled:presses withEvent:event];
+}
+
+@end
