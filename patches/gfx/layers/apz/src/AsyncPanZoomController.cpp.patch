-void AsyncPanZoomController::SetFixedLayerMargins(const ScreenMargin& aMargin) {
+void AsyncPanZoomController::SetFixedLayerMargins(const ScreenMargin& aMargin,
+                                                  ScreenCoord aTopInset,
+                                                  ScreenCoord aBottomInset) {
   RecursiveMutexAutoLock lock(mRecursiveMutex);
+  const bool marginsChanged = mCompositorFixedLayerMargins != aMargin;
   mCompositorFixedLayerMargins = aMargin;
+  const ParentLayerCoord topInset = ViewAs<ParentLayerPixel>(
+      aTopInset, PixelCastJustification::ScreenIsParentLayerForRoot);
+  const ParentLayerCoord bottomInset = ViewAs<ParentLayerPixel>(
+      aBottomInset, PixelCastJustification::ScreenIsParentLayerForRoot);
+  if (Metrics().GetContentTopInset() == topInset &&
+      Metrics().GetContentBottomInset() == bottomInset) {
+    if (marginsChanged) {
+      RequestContentRepaint(RepaintUpdateType::eVisualUpdate);
+    }
+    return;
+  }
+
+  CSSPoint offset = Metrics().GetVisualScrollOffset();
+  const bool atTop = offset.y <= Metrics().CalculateScrollRange().Y();
+  Metrics().SetContentTopInset(topInset);
+  Metrics().SetContentBottomInset(bottomInset);
+  if (atTop) {
+    const CSSCoord scrollTop = Metrics().CalculateScrollRange().Y();
+    CSSPoint layoutOffset = Metrics().GetLayoutScrollOffset();
+    // Keep both viewports aligned when the inset moves the page's origin.
+    layoutOffset.y += scrollTop - offset.y;
+    Metrics().SetLayoutScrollOffset(layoutOffset);
+    offset.y = scrollTop;
+  }
+  Metrics().ClampAndSetVisualScrollOffset(offset);
+  Metrics().RecalculateLayoutViewportOffset();
+  for (auto& sampledState : mSampledState) {
+    sampledState.UpdateScrollProperties(Metrics());
+  }
+  ScheduleComposite();
+  RequestContentRepaint(RepaintUpdateType::eVisualUpdate);
 }
 
