+mozilla::ipc::IPCResult CamerasChild::RecvDeliverFrameIOSurface(
+    const int& aCaptureId, const uint64_t& aFrameId, nsTArray<int>&& aStreamIds,
+    layers::IOSurfacePort&& aSurface, const gfx::IntRect& aPictureRect,
+    const gfx::YUVColorSpace& aYUVColorSpace,
+    const gfx::ColorSpace2& aColorPrimaries,
+    const gfx::TransferFunction& aTransferFunction,
+    const VideoFrameProperties& aProps) {
+  auto surfaceRef = aSurface.GetSurface();
+  if (!surfaceRef) {
+    SendReleaseFrameIOSurface(aCaptureId, aFrameId);
+    return IPC_OK();
+  }
+
+  RefPtr<MacIOSurface> surface =
+      new MacIOSurface(std::move(surfaceRef), aYUVColorSpace, aTransferFunction,
+                       MacIOSurface::AllowAlpha::No);
+  surface->mColorPrimaries = aColorPrimaries;
+  auto release = [child = RefPtr(this), target = GetCurrentSerialEventTarget(),
+                  captureId = aCaptureId, frameId = aFrameId] {
+    (void)target->Dispatch(NS_NewRunnableFunction(
+        "camera::ReleaseFrameIOSurface",
+        [child = std::move(child), captureId, frameId] {
+          if (child->mIPCIsAlive) {
+            child->SendReleaseFrameIOSurface(captureId, frameId);
+          }
+        }));
+  };
+  RefPtr<layers::Image> image =
+      new CameraMacIOSurfaceImage(surface, aPictureRect, std::move(release));
+
+  MutexAutoLock lock(mCallbackMutex);
+  for (const int& streamId : aStreamIds) {
+    if (auto* cb = Callback(streamId)) {
+      cb->DeliverFrame(image, aProps);
+    } else {
+      LOG("DeliverFrameIOSurface called with dead callback");
+    }
+  }
+
+  return IPC_OK();
+}
