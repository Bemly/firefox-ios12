+class DeliverIOSurfaceFrameRunnable : public mozilla::Runnable {
+ public:
+  DeliverIOSurfaceFrameRunnable(
+      already_AddRefed<CamerasParent> aParent, int aCaptureId,
+      uint64_t aFrameId, nsTArray<int>&& aStreamIds,
+      webrtc::videocapturemodule::NativeIOSurfaceFrame aSurfaceFrame,
+      const VideoFrameProperties& aProperties)
+      : Runnable("camera::DeliverIOSurfaceFrameRunnable"),
+        mParent(aParent),
+        mCaptureId(aCaptureId),
+        mFrameId(aFrameId),
+        mStreamIds(std::move(aStreamIds)),
+        mSurfaceFrame(std::move(aSurfaceFrame)),
+        mProperties(aProperties) {}
+
+  ~DeliverIOSurfaceFrameRunnable() override {
+    if (!mSent) {
+      mParent->ReleaseIOSurfaceFrame(mCaptureId, mFrameId);
+    }
+  }
+
+  NS_IMETHOD Run() override {
+    mParent->mPBackgroundEventTarget.AssertOnCurrentThread();
+    if (mParent->mDestroyed) {
+      return NS_OK;
+    }
+    mSent = mParent->SendDeliverFrameIOSurface(
+        mCaptureId, mFrameId, mStreamIds, std::move(mSurfaceFrame.mSurface),
+        mSurfaceFrame.mPictureRect, mSurfaceFrame.mYUVColorSpace,
+        mSurfaceFrame.mColorPrimaries, mSurfaceFrame.mTransferFunction,
+        mProperties);
+    return NS_OK;
+  }
+
+ private:
+  const RefPtr<CamerasParent> mParent;
+  const int mCaptureId;
+  const uint64_t mFrameId;
+  const nsTArray<int> mStreamIds;
+  webrtc::videocapturemodule::NativeIOSurfaceFrame mSurfaceFrame;
+  const VideoFrameProperties mProperties;
+  bool mSent = false;
 };
 
