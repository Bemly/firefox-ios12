+bool CamerasParent::TryReservePendingFrame(int aCaptureId) {
+  auto guard = mPendingFrames.Lock();
+  return guard->insert(aCaptureId).second;
+}
+
+void CamerasParent::ReleasePendingFrame(int aCaptureId) {
+  auto guard = mPendingFrames.Lock();
+  MOZ_ALWAYS_TRUE(guard->erase(aCaptureId));
+}
+
+Maybe<uint64_t> CamerasParent::HoldIOSurfaceFrame(
+    int aCaptureId, const webrtc::VideoFrame& aFrame) {
+  auto guard = mIOSurfaceFrames.Lock();
+
+  // 2 frames, one is the current img, and one is the next img. This is because
+  // the current image only gets released when a new one arrives
+  constexpr size_t kMaxOutstandingFrames = 2;
+  auto& frames = guard->mFrames[aCaptureId];
+
+  if (frames.size() >= kMaxOutstandingFrames) {
+    return Nothing();
+  }
+
+  const uint64_t frameId = guard->mNextFrameId++;
+  frames.emplace(frameId, aFrame);
+  return Some(frameId);
+}
+
+bool CamerasParent::ReleaseIOSurfaceFrame(int aCaptureId, uint64_t aFrameId) {
+  auto guard = mIOSurfaceFrames.Lock();
+  auto it = guard->mFrames.find(aCaptureId);
+
+  if (it == guard->mFrames.end() || !it->second.erase(aFrameId)) {
+    return false;
+  }
+
+  if (it->second.empty()) {
+    guard->mFrames.erase(it);
+  }
+
+  return true;
+}
